NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-23
# Must match the live host (Vercel currently serves www).
NEXT_PUBLIC_SITE_URL=https://www.sadiaestate.cz
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required on Vercel for CMS, admin, and live listings.
# The public site can still build without them (mock content).

# Admin dashboard (/admin)
ADMIN_PASSWORD=

# Sanity write token (Editor role) for admin CRUD
SANITY_API_WRITE_TOKEN=

# Public inquiry forms (contact, project, we-buy)
# Create a key at https://resend.com and verify the sending domain.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=SADIA <noreply@sadiaestate.cz>
INQUIRY_TO_EMAIL=adam@sadiaestate.cz
